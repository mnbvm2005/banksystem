<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>CommunityPay</display-name>
    <welcome-file-list>
        <welcome-file>login</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>LoginController</servlet-name>
        <servlet-class>communitypay.controller.LoginController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginController</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutController</servlet-name>
        <servlet-class>communitypay.controller.LogoutController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutController</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BillsController</servlet-name>
        <servlet-class>communitypay.controller.BillsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BillsController</servlet-name>
        <url-pattern>/bills</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RecordsController</servlet-name>
        <servlet-class>communitypay.controller.RecordsController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecordsController</servlet-name>
        <url-pattern>/records</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ApiController</servlet-name>
        <servlet-class>communitypay.controller.ApiController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApiController</servlet-name>
        <url-pattern>/api</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PayController</servlet-name>
        <servlet-class>communitypay.controller.PayController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PayController</servlet-name>
        <url-pattern>/pay</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResultController</servlet-name>
        <servlet-class>communitypay.controller.ResultController</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResultController</servlet-name>
        <url-pattern>/result</url-pattern>
    </servlet-mapping>
</web-app>
